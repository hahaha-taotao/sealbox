{
  "manifest_version": 3,
  "name": "Sealbox 印盒",
  "version": "0.1.3",
  "description": "按当前网址从本地 Sealbox 填充或登记网站密码。密钥不离开本机。",
  "action": {
    "default_title": "Sealbox",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab", "scripting", "webNavigation"],
  "host_permissions": ["http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "fill-current": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "打开当前页的账号选择并填充"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["fill-logic.cjs", "page-fill.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}

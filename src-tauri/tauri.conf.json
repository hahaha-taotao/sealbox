{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sealbox",
  "version": "0.1.6",
  "identifier": "com.sealbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sealbox 印盒",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      },
      {
        "label": "quick",
        "title": "Sealbox 速查",
        "url": "quick.html",
        "width": 440,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzNDIzNTUxM0Q0NEZEMzcKUldRMy9VUTlVVFZDMCtHZnVkUWxzbWxXUFpTUGV2WXRMeUJIR2ptUFM2VkJlWVkrZDh1NUpaeHMK",
      "endpoints": [
        "https://github.com/hahaha-taotao/sealbox/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Sealbox",
    "shortDescription": "Sealbox 印盒 — 本地凭据金库",
    "longDescription": "A local credential vault for Windows. Unlock with a master password (optional Windows Hello). Website logins, API tokens, SSH keys, mailboxes, servers, and databases stay encrypted on disk.",
    "category": "Utility",
    "resources": {
      "../extension/manifest.json": "extension/manifest.json",
      "../extension/background.js": "extension/background.js",
      "../extension/content.js": "extension/content.js",
      "../extension/fill-logic.cjs": "extension/fill-logic.cjs",
      "../extension/overlay-inject.js": "extension/overlay-inject.js",
      "../extension/overlay.html": "extension/overlay.html",
      "../extension/overlay.js": "extension/overlay.js",
      "../extension/page-fill.js": "extension/page-fill.js",
      "../extension/popup.css": "extension/popup.css",
      "../extension/popup.html": "extension/popup.html",
      "../extension/popup.js": "extension/popup.js"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
